# ---- WhatsApp Cloud API (developers.facebook.com > App Anda > WhatsApp > API Setup) ----
WHATSAPP_TOKEN=isi_access_token_permanen
WHATSAPP_PHONE_NUMBER_ID=isi_phone_number_id
# Bebas Anda tentukan, harus sama dengan yang diisi di pengaturan Webhook Meta
WHATSAPP_VERIFY_TOKEN=rahasia-bebas-buatan-anda
# App Settings > Basic > App Secret (untuk memverifikasi pesan benar dari Meta)
WHATSAPP_APP_SECRET=isi_app_secret
GRAPH_API_VERSION=v23.0

# ---- Google Sheets ----
# ID ada di URL sheet: https://docs.google.com/spreadsheets/d/<ID_INI>/edit
SPREADSHEET_ID=isi_id_spreadsheet
# Pilih salah satu: path file JSON service account, ATAU isi JSON-nya langsung (satu baris)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# "sheets" (produksi) atau "memory" (coba-coba tanpa Google Sheets, data hilang saat restart)
STORAGE=sheets

# ---- Pengaturan cafe ----
CAFE_NAME=Cafe Kita
DISCOUNT_PERCENT=2
CODE_PREFIX=CAFE
# Lama kode diskon berlaku (hari)
CODE_VALID_DAYS=7
# Satu nomor hanya bisa mengisi survei sekali dalam sekian hari (0 = tanpa batas)
SURVEY_COOLDOWN_DAYS=30
# Nomor WA kasir/admin yang boleh pakai /cek dan /pakai (format 62..., pisahkan dengan koma)
ADMIN_NUMBERS=6281234567890
TIMEZONE=Asia/Jakarta
# Kontak untuk permintaan data di halaman /privacy (email atau nomor WA)
PRIVACY_CONTACT=

# ---- Promo / broadcast ----
# Kode bahasa template promo di Meta (id = Indonesian)
PROMO_TEMPLATE_LANGUAGE=id
# Jeda antar pesan saat broadcast (milidetik)
BROADCAST_DELAY_MS=200
PORT=3000
# Isi 127.0.0.1 jika bot berada di belakang Nginx di VPS (tidak bisa diakses langsung dari luar)
HOST=0.0.0.0
